  "cards": [
    {
      "dot": "violet",
      "title": "One decision per version",
      "items": [
        "The decision is written inside a transaction that locks the job row",
        "Sending the same decision again returns the first result instead of a duplicate"
      ]
    },
    {
      "dot": "amber",
      "title": "Links",
      "items": [
        "Only a PENDING version can be shared",
        "Replacing a link invalidates the old one; revoking blocks viewing and submitting"
      ]
    },
    {
      "dot": "emerald",
      "title": "After approval",
      "items": [
        "An approved job refuses new uploads; further work needs a new job",
        "The approval record keeps the image SHA-256, the name and the time"
      ]
    }
  ]
